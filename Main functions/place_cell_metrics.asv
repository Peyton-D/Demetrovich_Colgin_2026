function place_cell_metrics(cellStruct)
% Purpose: to compute place cell metrics (spatial correlation, rate
% overlap) from cellStruct, store in table (long) format, plot metrics, and
% run statistics 
% - note: the saving functions have been commented out. uncomment them if
% you would like to save tables, figure, and
% Inputs: 
%   cellStruct - data structure containing the cells from all recordings 
%
% Outputs:
%   Fig. 1 - ratemaps (Fig. 2 from paper)
%   Fig. 2 - global remapping (Fig. 3 from paper)
%   Fig. 3 - rate remapping (Fig. 4 from paper)
%
% Peyton Demetrovich
% Colgin Lab 4/8/26

%% initialize
comparisons = {'A-B', 'B-B''', 'B''-A''', 'A-B''', 'A-A'''};
spatBinSz = 6; 
cellType = {'dentate'};
combos = [1 2;
          2 3;
          3 4;
          1 3;
          1 4];

if strcmp(cellType, 'granule')
    minAvgFr = 0.1;
    maxAvgFr = 1;
elseif strcmp(cellType, 'mossy')
    minAvgFr = 1;
    maxAvgFr = 10;
else
    minAvgFr = 0.1;
    maxAvgFr = 10;
end

% data containers
cellID =[];
ratID = {};
condID = {};
dayID = {};
comboID = {};
uID = [];
rateMaps = []; 
spatCorr = [];
rateOverlap = [];

uCntr = 0;
%% GET DATA
for r = 1:length(cellStruct.rat)
    fprintf('%s\n', cellStruct.rat(r).name)
    for c=1:length(cellStruct.rat(r).cond)

        if c > length(cellStruct.rat(r).cond)
            continue
        end

        for d = 1:length(cellStruct.rat(r).cond(c).day)
            fprintf('\t%s Day %d\n', cellStruct.rat(r).cond(c).name, d)
            fprintf('\t\t%s\n', cellStruct.rat(r).cond(c).day(d).name)

            dgPCu = false(length(cellStruct.rat(r).cond(c).day(d).smRms_1d_v3),1);
            meanFrs = cellfun(@mean, cellStruct.rat(r).cond(c).day(d).smRms_1d_v3);
            isPC = cell2mat(cellStruct.rat(r).cond(c).day(d).isPlaceCell);

            for u = 1:length(cellStruct.rat(r).cond(c).day(d).smRms_1d_v3)
                if (r==2 & c==2 & d== 1 & u==33) | (r==2 & c==6 & d==1 & u==31) | (r==2 & c==1 & d==1 & u==23) | (r==2 & c==1 & d==1 & u==32)% duplicate cells
                    continue
                end

                uRateMaps = zeros(4,360/spatBinSz); %for storing rate maps from all begins for this unit
                uTimeMaps = zeros(4,360/spatBinSz);

                if ismember(cellStruct.rat(r).cond(c).day(d).session(1).uID(u).cellType, {'dentate'}) & ...
                        any(meanFrs(u,:) >= minAvgFr) & all(meanFrs(u,:) < maxAvgFr) & any(isPC(u,:))

                    for b = 1:4
                        uRateMaps(b,:) = cellStruct.rat(r).cond(c).day(d).smRms_1d_v3{u,b}; %get all of the ratemaps for the spat corr comparisons
                        uTimeMaps(b,:) = cellStruct.rat(r).cond(c).day(d).timePerBin_v3{u,b};
                    end %begin

                    dgPCu(u) = true;
                    uCntr = uCntr +1;

                    for cb = 1%:size(combos,1)
                        cellID = [cellID; uCntr];
                        ratID  = [ratID; cellStruct.rat(r).name];
                        condID = [condID; cellStruct.rat(r).cond(c).name];
                        dayID  = [dayID; cellStruct.rat(r).cond(c).day(d).name];
                        comboID = [comboID; comparisons{cb}];
                        uID = [uID; u];

                        b1 = combos(cb,1); %begins to compare
                        b2 = combos(cb,2);

                        rm1 = uRateMaps(b1,:); %ratemaps to compare
                        rm2 = uRateMaps(b2,:);

                        rateMaps = [rateMaps; {[rm1; rm2]}];

                        scMat = corrcoef(rm1,rm2);
                        spatCorr = [spatCorr; scMat(2)];

                        avgfr1 = nanmean(uRateMaps(b1,:));
                        avgfr2 = nanmean(uRateMaps(b2,:));
                        rateRatio = min([avgfr1 avgfr2]) / max([avgfr1 avgfr2]); % Calculate the rate ratio with the lower FR as numerator
                        rateOverlap = [rateOverlap; rateRatio];

                    end %combos
                end % good unit
            end %unit
            if strcmp(cellType, 'granule')
                cellStruct.rat(r).cond(c).day(d).granU = dgPCu;
            elseif strcmp(cellType, 'mossy')
                cellStruct.rat(r).cond(c).day(d).mossyU = dgPCu;
            else
                cellStruct.rat(r).cond(c).day(d).dgPcU = dgPCu;
            end

        end %day

    end % cond

end %rat

% fisher r-to-z transformation for spatial correlation
spatCorr_z = atanh(spatCorr); 

% logit transform for rate overlap
rateOverlap_log = log( (rateOverlap ./ (1 - rateOverlap)) ); 

% create table
table_for_stats = table(cellID, uID, strrep(dayID, '_', '-'), ratID, condID, comboID, rateMaps, spatCorr, spatCorr_z, rateOverlap, rateOverlap_log, ...
    'VariableNames', {'Cell', 'Unit', 'Day', 'Rat', 'Condition', 'Session', 'RateMaps', 'SpatCorr', 'SpatCorr_norm', 'RateOverlap', 'RateOverlap_logit'});

save(['remappingTable_' date '.mat'], 'table_for_stats')
cd Figures
%% plot rate maps from table
cols = {[0.0 0.45 0.70] [0.85 0.37 0.01] [0.93 0.69 0.13] [0.0 0.62 0.45] [0.80 0.47 0.74] [0.8203 0.7031 0.5469]};
rats = {'Rat452', 'Rat451', 'Rat501', 'Rat504', 'Rat503'};
conditionNames = {'Empty', 'Social', 'Social Odor', 'Nonsocial Odor', 'Fox Odor', 'Novel Room'};
comparisons = {'A-B'};
conditions = {'Empty' 'Social' 'SocialOdor' 'NonSocialOdor' 'FoxOdor' 'NovelRoom'};
num_conditions = numel(conditions);

figure, theme(gcf, 'light'), clf
pltCntr = 1; 
for c=1:num_conditions
    % get data from specific condition and session across animals
    pullDataInds = strcmp(table_for_stats.Condition, conditions{c}) & strcmp(table_for_stats.Session, comparisons{1});
    cond_data = table_for_stats(pullDataInds,:);

    tmpRms = cond_data.RateMaps(:);

    % extract the rows from each cell 
    firstRows  = cell2mat(cellfun(@(x) x(1,:), tmpRms, 'UniformOutput', false));
    secondRows = cell2mat(cellfun(@(x) x(2,:), tmpRms, 'UniformOutput', false));

    % concatenate, normalize, then split 
    catRows = [firstRows secondRows];
    catRows_norm = peak_rate_normalize_rows(catRows);
    firstRows_norm = catRows_norm(:,1:60);
    secondRows_norm = catRows_norm(:,61:120);
    
    % sort by first session
    [~, maxInd] = max(firstRows_norm,[],2);
    [~,sortInd] = sort(maxInd);
    
    % plot
    subplot(3,4,pltCntr)
    imagesc(firstRows_norm(sortInd,:))
    % title([' A'])
    xlabel('Position (bins)')
    ylabel({conditionNames{c}; 'Cell ID'})
    pltCntr = pltCntr + 1;
    
    subplot(3,4,pltCntr)
    imagesc(secondRows_norm(sortInd,:))
    xlabel('Position (bins)')
    yticks('')
    % title([' B'])
    if pltCntr == 12
        clbr = colorbar;
        clbr.Position = [0.91    0.1164    0.0100    0.0907];
        clbr.Ticks = [0.1 1];
        clbr.TickLabels = {'Min', 'Max'};
        ylabel(clbr, 'Firing rate')
    end
    pltCntr = pltCntr + 1;
    
end
colormap jet
SetFigureDefaults()

% add zone bars to ratemaps
for i=1:11
        h = subplot(3,4,i);
        switch i
            case {1,2}
                add_highlight_above_axes(h, [45/6 135/6; 180/6 270/6], 0.005, 0.005, [0 0 0; cols{1}]);
            case {3,4}
                add_highlight_above_axes(h, [45/6 135/6; 180/6 270/6], 0.005, 0.005, [0 0 0; cols{2}]);
            case {5,6}
                add_highlight_above_axes(h, [45/6 135/6; 180/6 270/6], 0.005, 0.005, [0 0 0; cols{3}]);
            case {7,8}
                add_highlight_above_axes(h, [45/6 135/6; 180/6 270/6], 0.005, 0.005, [0 0 0; cols{4}]);
            case {9,10}
                add_highlight_above_axes(h, [45/6 135/6; 180/6 270/6], 0.005, 0.005, [0 0 0; cols{5}]);
            case {11}
                add_highlight_above_axes(h, [45/6 135/6; 180/6 270/6], 0.005, 0.005, [0 0 0; cols{6}]);
        end
end
savefig(gcf,'allCells')
saveas(gcf, 'allCells', 'png')
saveas(gcf, 'allCells', 'epsc')
%% rat-specific marker dotplots

markers = {'o', '>', 'd', 's', '<'};
metric = {'SpatCorr', 'RateOverlap'};
colorInds = [1,2,3,4,5,6];

% subplot(3,3,1:4)
for m=1:length(metric)
    figure, theme(gcf, "light");
    for b=1%:length(comparisons)
        subplot(3,3,[1 4])
        hold on;
        
        % dummy vals for legend
        scatter(nan, nan, 'Marker', 'o','MarkerEdgeColor', 'k', 'LineWidth', 1, 'DisplayName', 'Rat 452');
        scatter(nan, nan, 'Marker', '>','MarkerEdgeColor', 'k', 'LineWidth', 1, 'DisplayName', 'Rat 451');
        scatter(nan, nan, 'Marker', 'd','MarkerEdgeColor', 'k', 'LineWidth', 1, 'DisplayName', 'Rat 501');
        scatter(nan, nan, 'Marker', 's','MarkerEdgeColor', 'k', 'LineWidth', 1, 'DisplayName', 'Rat 504');
        scatter(nan, nan, 'Marker', '<','MarkerEdgeColor', 'k', 'LineWidth', 1, 'DisplayName', 'Rat 503');
        legend('show');
        legend('autoupdate', 'off');
        legend location southwest

        for i = 1:numel(rats)
            if m == 1
                pullData = strcmp(table_for_stats.Rat, rats{i}) & strcmp(table_for_stats.Session, comparisons{b});
                rat_data = table_for_stats(pullData, :);
            else
                pullData = strcmp(stableTable.Rat, rats{i}) & strcmp(stableTable.Session, comparisons{b});
                rat_data = stableTable(pullData, :);
            end

            for j = 1:num_conditions
                cond = conditions{j};
                % rat and cond-specific data
                cond_data = rat_data(strcmp(rat_data.Condition, cond), :);
                if ~isempty(cond_data)
                    x_jitter = j + 0.3 * (rand(height(cond_data),1) - 0.5); % Add jitter
                    scttr = scatter(x_jitter, cond_data.(metric{m}), 100, ...
                        'Marker', markers{i}, ...
                        'MarkerEdgeColor', 'k', ...
                        'MarkerFaceColor', cols{colorInds(j)}, ... 
                        'DisplayName', rats{i}, 'LineWidth', 1);
                end
            end
        end

        for i=1:num_conditions
            % plot medians for each condition
            if m == 1 
                pullData = strcmp(table_for_stats.Condition, conditions{i}) & strcmp(table_for_stats.Session, comparisons{b});
                cond_data = table_for_stats(pullData,:);
            else
                pullData = strcmp(stableTable.Condition, conditions{i}) & strcmp(stableTable.Session, comparisons{b});
                cond_data = stableTable(pullData,:);
            end

            scatter(i, nanmedian(cond_data.(metric{m})),100, 'Marker', 'x',...
                'MarkerEdgeColor', 'k', 'LineWidth', 2);

            if i==1 & m==1 
                % kmeans thresholding
                [~, C] = kmeans(cond_data.(metric{m}), 2, 'Replicates', 50);
                sc_thresh = mean(C);  % approximate boundary
                yline(sc_thresh,'r--');
                text(-1,sc_thresh+.075, {'Stability'; 'Threshold'}, 'Color', 'r')
            end
           
        end

        xlim([-1, num_conditions + 1]);
        xticks('');
        if m==1
            ylabel('Spatial Correlation');
            ylim([-1 1])
        else
            ylabel('Rate Overlap')
            ylim([0 1])
        end

        SetFigureDefaults
%         saveas(gcf, [metric{m} '_' comparisons{b} '_dotplot'], 'epsc')
%         saveas(gcf, [metric{m} '_' comparisons{b} '_dotplot'], 'png')
    end
    if m == 1 % create table of stable cells using threshold from empty condition spatial correlations
        stableTable = table_for_stats(table_for_stats.SpatCorr > sc_thresh,:); 
    end
end

%% cumulative probability
tileNum = [2,3,5,6,8];
condCount = length(unique(table_for_stats.Condition));
distTest = 'ks'; % either 'ks' for 2-sample kolmogorov-smirnov or 'ad' for 2-sample anderson-darling

for m = 1:length(metric)
    for b=1%:size(combos,1)

        if m == 1
            pullData = strcmp(table_for_stats.Condition, 'Empty') & strcmp(table_for_stats.Session, comparisons{b});
            control_data = table_for_stats.(metric{m})(pullData,:);
        else
            pullData = strcmp(stableTable.Condition, 'Empty') & strcmp(stableTable.Session, comparisons{b});
            control_data = stableTable.(metric{m})(pullData,:);
        end

        control_data(isnan(control_data)) = [];

        for c = 2:condCount
            if m == 1
                pullData = strcmp(table_for_stats.Condition, conditions{c}) & strcmp(table_for_stats.Session, comparisons{b});
                cond_data = table_for_stats.(metric{m})(pullData,:);
            else
                pullData = strcmp(stableTable.Condition, conditions{c}) & strcmp(stableTable.Session, comparisons{b});
                cond_data = stableTable.(metric{m})(pullData,:);
            end

            cond_data(isnan(cond_data)) = [];

            if isempty(cond_data)
                continue
            end
            
            figure(m+1),
            subplot(3,3,tileNum(c-1)), cla
            [control_f, x, flo, fup] = ecdf(control_data, 'Alpha', 0.05, 'Bounds','on');
            stairs(x, control_f, 'Color', cols{1}, 'DisplayName', conditions{1}, 'LineWidth', 2);            % CDF
            hold on;
            plot(x, flo, '--', x, fup, '--', 'Color', cols{1});  % 95% CI
            
            [cond_f, x, flo, fup] = ecdf(cond_data, 'Alpha', 0.05, 'Bounds','on');
            stairs(x, cond_f, 'Color', cols{c}, 'DisplayName', conditions{c}, 'LineWidth', 2);            % CDF
            plot(x, flo, '--', x, fup, '--', 'Color', cols{c});  % 95% CI

            switch distTest
                case 'ks'
                    [~,p,stat] = kstest2(control_data, cond_data,'Tail', 'smaller'); % If the data values in x1 tend to be larger than those in x2, the empirical distribution function of x1 tends to be smaller than that of x2, and vice versa.
                    if  c==6 
                        format shortE
                        title({ [conditionNames{c} ' vs ' conditionNames{1}]; ['p = ' num2str(p) ', ks2stat = ' num2str(round(stat,3))] })
                        format default
                    else
                        title({ [conditionNames{c} ' vs ' conditionNames{1}]; ['p = ' num2str(round(p,3)) ', ks2stat = ' num2str(round(stat,3))] })
                    end
                case 'ad'
                    [stat, p] = ad2test(control_data, cond_data); 
                    title({ [conditionNames{c} ' vs ' conditionNames{1}]; ['p = ' num2str(round(p,3)) ', ad2stat = ' num2str(round(stat,3))] })
            end
           
            ylabel('Cumulative Probabilty')
            if m==1
                xlabel('Spatial Correlation')
            else
                xlabel('Rate Overlap')
            end
            axis square
            yticks([0 0.5 1])
           
            
            if c == 3 & m == 1 
                if m == 1
                    pullData = strcmp(table_for_stats.Condition, 'SocialOdor') & strcmp(table_for_stats.Session, comparisons{b});
                    so_data = table_for_stats.(metric{m})(pullData,:);

                    pullData = strcmp(table_for_stats.Condition, 'NonSocialOdor') & strcmp(table_for_stats.Session, comparisons{b});
                    nso_data = table_for_stats.(metric{m})(pullData,:);

                    pullData = strcmp(table_for_stats.Condition, 'FoxOdor') & strcmp(table_for_stats.Session, comparisons{b});
                    fo_data = table_for_stats.(metric{m})(pullData,:);
                else
                    pullData = strcmp(stableTable.Condition, 'SocialOdor') & strcmp(stableTable.Session, comparisons{b});
                    so_data = stableTable.(metric{m})(pullData,:);

                    pullData = strcmp(stableTable.Condition, 'NonSocialOdor') & strcmp(stableTable.Session, comparisons{b});
                    nso_data = stableTable.(metric{m})(pullData,:);

                    pullData = strcmp(stableTable.Condition, 'FoxOdor') & strcmp(stableTable.Session, comparisons{b});
                    fo_data = stableTable.(metric{m})(pullData,:);
                end
                
                so_data(isnan(so_data)) = [];
                nso_data(isnan(nso_data)) = [];
                fo_data(isnan(fo_data)) = [];
                
                subplot(3,3,9), cla
                [so_f, x, flo, fup] = ecdf(so_data, 'Alpha', 0.05, 'Bounds','on');
                stairs(x, so_f, 'Color', cols{3}, 'DisplayName', conditions{3}, 'LineWidth', 2);            % CDF
                hold on;
                plot(x, flo, '--', x, fup, '--', 'Color', cols{3});  % 95% CI
                
                [nso_f, x, flo, fup] = ecdf(nso_data, 'Alpha', 0.05, 'Bounds','on');
                stairs(x, nso_f, 'Color', cols{4}, 'DisplayName', conditions{4}, 'LineWidth', 2);            % CDF
                plot(x, flo, '--', x, fup, '--', 'Color', cols{4});  % 95% CI

                [fo_f, x, flo, fup] = ecdf(fo_data, 'Alpha', 0.05, 'Bounds','on');
                stairs(x, fo_f, 'Color', cols{5}, 'DisplayName', conditions{5}, 'LineWidth', 2);            % CDF
                plot(x, flo, '--', x, fup, '--', 'Color', cols{5});  % 95% CI
                

                switch distTest
                    case 'ks'
                        [~,p1,stat1] = kstest2(so_data, nso_data);
                        [~,p2,stat2] = kstest2(so_data, fo_data);
                        title({ ['SO vs NSO: p = ' num2str(round(p1,3)) ', ks2stat = ' num2str(round(stat1,3))]; ['SO vs FO: p = ' num2str(round(p2,3)) ', ks2stat = ' num2str(round(stat2,3))] })
                    case 'ad'
                        [stat1, p1] = ad2test(so_data,  nso_data);
                        [stat2, p2] = ad2test(nso_data, fo_data);
                        title({ ['SO vs NSO: p = ' num2str(round(p1,3)) ', ad2stat = ' num2str(round(stat1,3))]; ['SO vs FO: p = ' num2str(round(p2,3)) ', ad2stat = ' num2str(round(stat2,3))] })
                end
                
                axis square
                ylabel('Cumulative Probabilty')
                if m==1
                    xlabel('Spatial Correlation')
                else
                    xlabel('Rate Overlap')
                end
                yticks([0 0.5 1])
            end
        end
        % sgtitle(comparisons{b})
        % saveas(gcf,[metric{m} '_' comparisons{b} '_cumulativeProb'], 'png')
        % saveas(gcf,[metric{m} '_' comparisons{b} '_cumulativeProb'], 'epsc')
        % SetFigureDefaults()
    end
end

%% Linear mixed model statistics 
table_for_stats.Cell = categorical(table_for_stats.Cell);
table_for_stats.Rat = categorical(table_for_stats.Rat);
table_for_stats.Rat = reordercats(table_for_stats.Rat, {'Rat452', 'Rat451', 'Rat501', 'Rat504', 'Rat503'});
table_for_stats.Condition = categorical(table_for_stats.Condition);
table_for_stats.Condition = reordercats(table_for_stats.Condition, {'Empty', 'Social', 'SocialOdor', 'NonSocialOdor', 'FoxOdor', 'NovelRoom'});
table_for_stats.Session = categorical(table_for_stats.Session);

% fit model
lme = fitlme(table_for_stats, ...
    'SpatCorr_norm ~ Condition  + (1|Rat)', 'Verbose', 1, 'DummyVarCoding', 'reference');

% test for overall effect of condition
anv = anova(lme)
% save([metric{m} '_remapping_lme.mat'], 'lme', 'anv')

% get estimated marginal means
% Define categories
conditions = unique(table_for_stats.Condition);
sessions = unique(table_for_stats.Session);

% Create grid of all combinations
[C, S] = ndgrid(conditions, sessions);

% Create dummy values for Rat and Cell
n = numel(C);
dummyRat = repmat("DummyRat", n, 1);
dummyCell = repmat("DummyCell", n, 1);

% Build table
newTbl = table(C(:), S(:), categorical(dummyRat), categorical(dummyCell), ...
    'VariableNames', {'Condition', 'Session', 'Rat', 'Cell'});

% plot 
[yhat, yCI] = predict(lme, newTbl, 'Conditional', false);
figure(2), subplot(3,3,7), cla, hold on
for c=1:6
    plot([c,c],[yCI(c,1), yCI(c,2)], 'Color', cols{c}, 'LineWidth', 2)
    plot(c, yhat(c), 'ko')
end
xticks([1:length(conditions)])
xticklabels(conditionNames)
xtickangle(45)
xlim([-1 7])
ylabel({'Spatial Correlation'; '(Fisher''s r-to-z)'})

% if significant main effect of condition, run post-hoc planned comparisons
if anv.pValue(end) < 0.05
    statPlan = {
        'Comparison', 'test-type', 'contrastLabel', 'Fstat', 'pTwo', 'df1','df2', 'Tstat', 'pNew', 'pNew_BF';
        'Empty vs Social', 'one-tailed', [0 1 0 0 0 0], nan, nan,nan, nan, nan,nan,nan;
        'Empty vs Social Odor', 'one-tailed', [0 0 1 0 0 0], nan, nan, nan, nan, nan,nan,nan;
        'Empty vs Nonsocial Odor', 'one-tailed', [0 0 0 1 0 0], nan, nan, nan, nan, nan,nan,nan;
        'Empty vs FoxOdor', 'one-tailed', [0 0 0 0 1 0], nan, nan, nan, nan, nan, nan,nan;
        'Empty vs NovelRoom', 'one-tailed', [0 0 0 0 0 1], nan, nan, nan, nan, nan, nan,nan;
        'Social Odor vs Fox Odor', 'two-tailed', [0 0 1 0 -1 0], nan, nan, nan, nan, nan, nan,nan;
        'Social Odor vs Nonsocial Odor','two-tailed', [0 0 1 -1 0 0], nan, nan, nan,  nan ,nan, nan,nan;
        };

    beta = fixedEffects(lme);       % p-by-1
    V    = lme.CoefficientCovariance; % p-by-p
    xpos = [1,2;
        1,3;
        1,4;
        1,5;
        1,6;
        3,5;
        3,4;

        ];
    % convert F to a signed t using the contrast estimate's direction, then use the t CDF for a "less-than" test.
    for i=2:size(statPlan,1)
        % H: 1-by-p contrast row (e.g., [0 1 -1 0 ...])
        H = statPlan{i,3};                  % adjust to your coefficient order

        % Wald F-test
        [pTwo, Fstat, df1, df2] = coefTest(lme, H);

        % Get the contrast estimate and its SE
        theta = H * beta;                % contrast estimate (β_level - β_ref)
        se    = sqrt(H * V * H.');       % standard error of the contrast

        % Convert to signed t-statistic (df1 must be 1)
        if df1 == 1
            tStat = theta / se;
            % One-tailed p-value for "lower than reference"
            if ismember(statPlan{i,2}, {'one-tailed'})
                pNew = tcdf(tStat, df2);         % uses left tail; small pOne supports θ < 0
            else
                pNew = 2 * min(tcdf(tStat, df2), 1 - tcdf(tStat, df2)); % two-tailed from t
            end
            pNew_bf = min(1, pNew .* (size(statPlan,1)-1));
            
            % store values
            statPlan{i,4} = Fstat;
            statPlan{i,5} = pTwo;
            statPlan{i,6} = df1;
            statPlan{i,7} = df2;
            statPlan{i,8} = tStat;
            statPlan{i,9} = pNew;
            statPlan{i,10} = pNew_bf;
            if statPlan{i,10} < 0.05
                sigstar(xpos(i-1,:), statPlan{i,10})
            end
        end
       
    end
    disp(statPlan)
    % writecell(statPlan, [metric{m} '_stats_' date '.csv']);
end
SetFigureDefaults()
% savefig(gcf,[metric{m} '_plots'])
% saveas(gcf, [metric{m} '_plots'], 'png')
% saveas(gcf, [metric{m} '_plots'], 'epsc')

%% for stable cell metrics
stableTable.Cell = categorical(stableTable.Cell);
stableTable.Rat = categorical(stableTable.Rat);
stableTable.Rat = reordercats(stableTable.Rat, {'Rat452', 'Rat451', 'Rat501', 'Rat504', 'Rat503'});
stableTable.Condition = categorical(stableTable.Condition);
stableTable.Condition = reordercats(stableTable.Condition, {'Empty', 'Social', 'SocialOdor', 'NonSocialOdor', 'FoxOdor'});
stableTable.Session = categorical(stableTable.Session);

% fit model
lme = fitlme(stableTable, ...
    'RateOverlap_logit ~ Condition + (1|Rat)', 'Verbose', 1, 'DummyVarCoding', 'reference');

% test for overall effect of condition
anv = anova(lme)
% save([metric{m} '_remapping_lme.mat'], 'lme', 'anv')

% get estimated marginal means
% Define categories
conditions = unique(stableTable.Condition);
sessions = unique(stableTable.Session);

% Create grid of all combinations
[C, S] = ndgrid(conditions, sessions);

% Create dummy values for Rat and Cell
n = numel(C);
dummyRat = repmat("DummyRat", n, 1);
dummyCell = repmat("DummyCell", n, 1);

% Build table
newTbl = table(C(:), S(:), categorical(dummyRat), categorical(dummyCell), ...
    'VariableNames', {'Condition', 'Session', 'Rat', 'Cell'});

[yhat, yCI] = predict(lme, newTbl, 'Conditional', false);
figure(3), subplot(3,3,7), cla, hold on
for c=1:length(C)
    plot([c,c],[yCI(c,1), yCI(c,2)], 'Color', cols{c}, 'LineWidth', 2)
    plot(c, yhat(c), 'ko')
end
xticks([1:length(conditions)])
xticklabels(conditionNames)
xtickangle(45)
xlim([-1 7])
ylabel({'Rate Overlap'; '(logit transform)'})

% if significant main effect of condition, run post-hoc planned comparisons
if anv.pValue(end) < 0.05
    statPlan = {
        'Comparison', 'test-type', 'contrastLabel', 'Fstat', 'pTwo', 'df1','df2', 'Tstat', 'pNew', 'pNew_corrected';
        'Empty vs Social', 'one-tailed', [0 1 0 0 0], nan, nan,nan, nan, nan,nan,nan;
        'Empty vs Social Odor', 'one-tailed', [0 0 1 0 0], nan, nan, nan, nan, nan,nan,nan;
        'Empty vs Nonsocial Odor', 'one-tailed', [0 0 0 1 0], nan, nan, nan, nan, nan,nan,nan;
        'Empty vs FoxOdor', 'one-tailed', [0 0 0 0 1], nan, nan, nan, nan, nan, nan,nan;
        'Social Odor vs Fox Odor', 'two-tailed', [0 0 1 0 -1], nan, nan, nan, nan, nan, nan,nan;
        'Social Odor vs Nonsocial Odor','two-tailed', [0 0 1 -1 0], nan, nan, nan,  nan ,nan, nan,nan;
        };

    beta = fixedEffects(lme);       % p-by-1
    V    = lme.CoefficientCovariance; % p-by-p
    xpos = [1,2;
        1,3;
        1,4;
        1,5;
        1,6;
        3,5;
        3,4;
        ];

    % convert F to a signed t using the contrast estimate's direction, then use the t CDF for a "less-than" test.
    for i=2:size(statPlan,1)
        % H: 1-by-p contrast row (e.g., [0 1 -1 0 ...])
        H = statPlan{i,3};                  % adjust to your coefficient order

        % Wald F-test
        [pTwo, Fstat, df1, df2] = coefTest(lme, H);

        % Get the contrast estimate and its SE
        theta = H * beta;                % contrast estimate (β_level - β_ref)
        se    = sqrt(H * V * H.');       % standard error of the contrast

        % Convert to signed t-statistic (df1 must be 1)
        if df1 == 1
            tStat = theta / se;
            % One-tailed p-value for "lower than reference"
            if ismember(statPlan{i,2}, {'one-tailed'})
                pNew = tcdf(tStat, df2);         % uses left tail; small pOne supports θ < 0
            else
                pNew = 2 * min(tcdf(tStat, df2), 1 - tcdf(tStat, df2)); % two-tailed from t
            end
            pNew_bf = min(1, pNew .* (size(statPlan,1)-1));

            % store values
            statPlan{i,4} = Fstat;
            statPlan{i,5} = pTwo;
            statPlan{i,6} = df1;
            statPlan{i,7} = df2;
            statPlan{i,8} = tStat;
            statPlan{i,9} = pNew;
            statPlan{i,10} = pNew_bf;
            if statPlan{i,10} < 0.05
                sigstar(xpos(i-1,:), statPlan{i,10})
            end
        end
    end
    disp(statPlan)
    % writecell(statPlan, [metric{m} '_stats_' date '.csv']);
end
SetFigureDefaults()
% savefig(gcf,[metric{m} '_plots'])
% saveas(gcf, [metric{m} '_plots'], 'png')
% saveas(gcf, [metric{m} '_plots'], 'epsc')
end
